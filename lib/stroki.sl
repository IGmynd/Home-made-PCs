# Библиотека строк для Слога. Подключение: подключить "stroki"
# Строки, которые возвращают функции, обычные. Списки строк (результат «слова») читаются
# с пометкой типа: строкой(список[номер]).

# начинается ли строка с префикса
функция начинается_с(с, префикс):
    если длина(префикс) > длина(с):
        вернуть ложь
    вернуть срез(с, 0, длина(префикс)) == префикс

# заканчивается ли строка суффиксом
функция заканчивается_на(с, суффикс):
    если длина(суффикс) > длина(с):
        вернуть ложь
    вернуть срез(с, длина(с) - длина(суффикс), длина(с)) == суффикс

# номер первого вхождения части в строку или -1
функция найти(с, часть):
    н = длина(часть)
    для к в диапазон(длина(с) - н + 1):
        если срез(с, к, к + н) == часть:
            вернуть к
    вернуть -1

функция содержит(с, часть):
    вернуть найти(с, часть) >= 0

# убрать пробелы по краям
функция обрезать(с):
    а = 0
    б = длина(с)
    пока а < б и с[а] == 32:
        а += 1
    пока б > а и с[б - 1] == 32:
        б -= 1
    вернуть срез(с, а, б)

# сколько слов в строке (слова разделены пробелами)
функция число_слов(с):
    итог = 0
    в_слове = ложь
    для х в с:
        если х == 32:
            в_слове = ложь
        иначе_если не в_слове:
            в_слове = истина
            итог += 1
    вернуть итог

# разбить строку на слова по пробелам: список строк
функция слова(с):
    результат = список(число_слов(с))
    номер = 0
    начало = -1
    для к в диапазон(длина(с) + 1):
        пробел = ложь
        если к == длина(с):
            пробел = истина
        иначе_если с[к] == 32:
            пробел = истина
        если пробел:
            если начало >= 0:
                результат[номер] = срез(с, начало, к)
                номер += 1
                начало = -1
        иначе_если начало < 0:
            начало = к
    вернуть результат

# соединить список строк через разделитель
функция соединить(части, разделитель):
    кол = длина(части)
    если кол == 0:
        вернуть ""
    всего = длина(разделитель) * (кол - 1)
    для к в диапазон(кол):
        всего += длина(строкой(части[к]))
    р = список(всего)
    поз = 0
    для к в диапазон(кол):
        если к > 0:
            для ч в разделитель:
                р[поз] = ч
                поз += 1
        для ч в строкой(части[к]):
            р[поз] = ч
            поз += 1
    вернуть строкой(р)

# повторить строку н раз
функция повторить(с, н):
    если н <= 0 или длина(с) == 0:
        вернуть ""
    р = список(длина(с) * н)
    для к в диапазон(длина(р)):
        р[к] = с[к % длина(с)]
    вернуть строкой(р)

# перевернуть строку
функция обратить(с):
    н = длина(с)
    р = список(н)
    для к в диапазон(н):
        р[н - 1 - к] = с[к]
    вернуть строкой(р)

# заглавные буквы (русские и латинские)
функция в_верхний(с):
    р = список(длина(с))
    для к в диапазон(длина(с)):
        х = с[к]
        если х >= 97 и х <= 122:
            х -= 32
        иначе_если х >= 1072 и х <= 1103:
            х -= 32
        иначе_если х == 1105:
            х = 1025
        р[к] = х
    вернуть строкой(р)

# строчные буквы (русские и латинские)
функция в_нижний(с):
    р = список(длина(с))
    для к в диапазон(длина(с)):
        х = с[к]
        если х >= 65 и х <= 90:
            х += 32
        иначе_если х >= 1040 и х <= 1071:
            х += 32
        иначе_если х == 1025:
            х = 1105
        р[к] = х
    вернуть строкой(р)