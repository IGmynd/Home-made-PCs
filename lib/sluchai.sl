# Случайные числа. Подключение: подключить "sluchai"
# Простой линейный генератор (как в старых библиотеках C): для игр и опытов, не для защиты.
# Чтобы последовательность каждый раз была новой, в начале программы: посеять(время())

состояние_случайных = 1

# задать начальное число; одинаковое начало даёт одинаковую последовательность
функция посеять(х):
    глобальная состояние_случайных
    состояние_случайных = х
    вернуть 0

# следующие 15 случайных бит (число от 0 до 32767)
функция случайных_15():
    глобальная состояние_случайных
    состояние_случайных = состояние_случайных * 1103515245 + 12345
    вернуть (состояние_случайных >> 16) & 32767

# случайное число от 0 до н - 1 (для н от 1 до миллиарда; иначе 0)
функция случайное(н):
    если н <= 0 или н > 1073741824:
        вернуть 0
    а = случайных_15()
    б = случайных_15()
    вернуть ((а << 15) | б) % н

# случайное число от от до до включительно
функция случайное_от(от, до):
    если до < от:
        вернуть от
    вернуть от + случайное(до - от + 1)