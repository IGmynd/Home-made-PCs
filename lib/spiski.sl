# Библиотека списков чисел для Слога. Подключение: подключить "spiski"

функция сумма(а):
    итог = 0
    для х в а:
        итог += х
    вернуть итог

# наибольший элемент (список не должен быть пустым)
функция наибольшее(а):
    м = а[0]
    для х в а:
        если х > м:
            м = х
    вернуть м

# наименьший элемент (список не должен быть пустым)
функция наименьшее(а):
    м = а[0]
    для х в а:
        если х < м:
            м = х
    вернуть м

# есть ли число в списке
функция содержит_число(а, число_для_поиска):
    для х в а:
        если х == число_для_поиска:
            вернуть истина
    вернуть ложь

# новый список с теми же элементами
функция копия(а):
    р = список(длина(а))
    для к в диапазон(длина(а)):
        р[к] = а[к]
    вернуть р

# перевернуть список на месте
функция перевернуть(а):
    н = длина(а)
    для к в диапазон(н // 2):
        врем = а[к]
        а[к] = а[н - 1 - к]
        а[н - 1 - к] = врем
    вернуть 0

# отсортировать список чисел по возрастанию на месте (вставками)
функция сортировать(а):
    для к в диапазон(1, длина(а)):
        значение = а[к]
        п = к - 1
        пока п >= 0 и а[п] > значение:
            а[п + 1] = а[п]
            п -= 1
        а[п + 1] = значение
    вернуть 0