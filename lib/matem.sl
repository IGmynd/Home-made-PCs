# Математика для целых чисел. Подключение: подключить "matem"

функция абс(х):
    если х < 0:
        вернуть -х
    вернуть х

функция мин(а, б):
    если а < б:
        вернуть а
    вернуть б

функция макс(а, б):
    если а > б:
        вернуть а
    вернуть б

# -1, 0 или 1
функция знак(х):
    если х < 0:
        вернуть -1
    иначе_если х > 0:
        вернуть 1
    вернуть 0

# основание в целой неотрицательной степени (для отрицательной степени результат 0)
функция степень(основание, показатель):
    если показатель < 0:
        вернуть 0
    итог = 1
    для к в диапазон(показатель):
        итог *= основание
    вернуть итог

# наибольший общий делитель
функция нод(а, б):
    а = абс(а)
    б = абс(б)
    пока б != 0:
        а, б = б, а % б
    вернуть а

# целая часть квадратного корня (для чисел меньше нуля результат 0)
функция корень(х):
    если х <= 0:
        вернуть 0
    низ = 0
    верх = 46340
    пока низ < верх:
        середина = (низ + верх + 1) // 2
        если середина * середина <= х:
            низ = середина
        иначе:
            верх = середина - 1
    вернуть низ

# остаток от деления, всегда от 0 до м - 1 (для м больше нуля)
функция по_модулю(а, м):
    вернуть ((а % м) + м) % м

# зажать число в границы от..до
функция ограничить(х, от, до):
    если х < от:
        вернуть от
    если х > до:
        вернуть до
    вернуть х