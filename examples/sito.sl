# Решето Эратосфена: простые числа до 100.
граница = 100
решето = список(граница + 1)
найдено = 0
для ч в диапазон(2, граница + 1):
    если решето[ч] == 0:
        найдено += 1
        к = ч * ч
        пока к <= граница:
            решето[к] = 1
            к += ч
печать("простых до", граница, "это", найдено)