# Пузырьковая сортировка списка.
данные = [5, 3, 9, 1, 7, 8, 2]
размер = длина(данные)
для проход в диапазон(0, размер - 1):
    для к в диапазон(0, размер - 1 - проход):
        если данные[к] > данные[к + 1]:
            врем = данные[к]
            данные[к] = данные[к + 1]
            данные[к + 1] = врем
печать("по порядку:")
для х в данные:
    печать(х)