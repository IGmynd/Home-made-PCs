# Бросок кубика. Каждый запуск новая последовательность (зерно берётся из часов).
подключить "sluchai"

посеять(время())
броски = список(6)
для к в диапазон(600):
    броски[случайное_от(1, 6) - 1] += 1
печать("бросков каждого вида из 600:")
для к в диапазон(6):
    печать(к + 1, "выпало", броски[к])