# Простые числа до 50 перебором делителей.
функция простое(н):
    если н < 2:
        вернуть ложь
    д = 2
    пока д * д <= н:
        если н % д == 0:
            вернуть ложь
        д += 1
    вернуть истина

число = 2
найдено = 0
пока число <= 50:
    если простое(число):
        печать(число)
        найдено += 1
    число += 1
печать("всего:", найдено)