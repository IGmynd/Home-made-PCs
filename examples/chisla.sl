# Числа через пробел: сортировка и итоги. Пример работы с библиотеками stroki и spiski.
подключить "stroki"
подключить "spiski"

печать("Введите числа через пробел:")
части = слова(ввод_строка())
числа = список(длина(части))
для к в диапазон(длина(части)):
    числа[к] = число(строкой(части[к]))

если длина(числа) == 0:
    печать("чисел нет")
иначе:
    сортировать(числа)
    текст = список(длина(числа))
    для к в диапазон(длина(числа)):
        текст[к] = строка(числа[к])
    печать("по возрастанию:", соединить(текст, " "))
    печать("сумма:", сумма(числа), "наибольшее:", наибольшее(числа), "наименьшее:", наименьшее(числа))