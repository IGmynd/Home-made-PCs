# Работа со строками: палиндромы и переворот.
функция обратить(с):
    р = ""
    для к в диапазон(длина(с)):
        р = из_кода(с[к]) + р
    вернуть р

функция палиндром(с):
    вернуть с == обратить(с)

слова = ["шалаш", "слог", "топот", "компьютер"]
для с в слова:
    слово = строкой(с)
    если палиндром(слово):
        печать(слово, "это палиндром")
    иначе:
        печать(слово, "наоборот:", обратить(слово))
печать("всего слов:", длина(слова), "букв в первом:", длина(слова[0]))