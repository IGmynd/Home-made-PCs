# Факториал: рекурсия и цикл.
функция факт(н):
    если н <= 1:
        вернуть 1
    вернуть н * факт(н - 1)

функция факт_цикл(н):
    итог = 1
    пока н > 1:
        итог *= н
        н -= 1
    вернуть итог

для_печати = 10
печать("факториал 10 =", факт(для_печати))
печать("через цикл:    ", факт_цикл(10))